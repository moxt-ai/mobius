{
    "name": "mobius-workspace",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.25.0",
    "engines": {
        "node": ">=24.15.0 <25",
        "pnpm": ">=11.25.0 <12"
    },
    "scripts": {
        "db:shard": "bash scripts/migrate-shard.sh",
        "db:environment": "bash scripts/migrate-environment.sh",
        "db:generate:non-cloud-retention-session-relay-do": "drizzle-kit generate --config drizzle/drizzle.non-cloud-retention-session-relay-do.config.ts && pnpm db:codegen",
        "db:generate:platform-d1": "drizzle-kit generate --config drizzle/drizzle.platform-d1.config.ts",
        "db:generate:project-do": "drizzle-kit generate --config drizzle/drizzle.project-do.config.ts && pnpm db:codegen",
        "db:generate:relay-d1": "drizzle-kit generate --config drizzle/drizzle.relay-d1.config.ts",
        "db:generate:runtime-connection-do": "drizzle-kit generate --config drizzle/drizzle.runtime-connection-do.config.ts && pnpm db:codegen",
        "db:generate:session-do": "drizzle-kit generate --config drizzle/drizzle.session-do.config.ts && pnpm db:codegen",
        "db:codegen": "node scripts/generate-sql-modules.ts",
        "prebuild": "pnpm db:codegen",
        "pretypecheck": "pnpm db:codegen",
        "pretest": "pnpm db:codegen",
        "dev": "pnpm dev:relay",
        "dev:cli": "pnpm --filter @moxt-ai/mobius dev",
        "dev:web": "pnpm --filter @moxt-ai/mobius-web dev",
        "dev:cloudflare": "pnpm --filter @moxt-ai/mobius-relay-cloudflare-standalone dev",
        "dev:cloudflare:platform": "pnpm --filter @moxt-ai/mobius-relay-cloudflare-platform dev",
        "dev:cloudflare:r2": "pnpm --filter @moxt-ai/mobius-relay-cloudflare-standalone dev:r2",
        "dev:relay": "pnpm dev:cloudflare",
        "dev:stack": "pnpm --parallel --filter @moxt-ai/mobius-relay-cloudflare-standalone --filter @moxt-ai/mobius-web dev",
        "deploy:temporary": "pnpm wrangler deploy --temporary",
        "deploy:cloudflare:r2": "pnpm --filter @moxt-ai/mobius-relay-cloudflare-standalone deploy:r2",
        "deploy:cloudflare:platform": "pnpm --filter @moxt-ai/mobius-relay-cloudflare-platform run deploy",
        "publish:platform-assets": "bash scripts/publish-platform-assets.sh",
        "mobius": "pnpm --filter @moxt-ai/mobius exec node src/cli.ts",
        "wrangler": "node scripts/wrangler.ts",
        "worktree:new": "bash scripts/worktree/new.sh",
        "worktree:setup": "bash scripts/worktree/setup.sh",
        "worktree:delete": "bash scripts/worktree/delete.sh",
        "worktree:reset": "bash scripts/worktree/reset.sh",
        "worktree:ports": "node scripts/worktree/port-allocator.mjs validate",
        "worktree:repair-ports": "node scripts/worktree/port-allocator.mjs repair",
        "build": "pnpm --recursive --workspace-concurrency=3 --filter '!@moxt-ai/mobius-web' --filter '!@moxt-ai/mobius-platform-app' --if-present build",
        "typecheck": "tsc --project tsconfig.json && pnpm --recursive --if-present typecheck",
        "check:no-chinese": "node scripts/check-no-chinese.ts",
        "lint": "biome ci --error-on-warnings && pnpm check:no-chinese && pnpm check:architecture",
        "check:architecture": "node scripts/check-architecture.ts",
        "lint:fix": "biome check --write --error-on-warnings && pnpm check:no-chinese",
        "format": "biome format --write",
        "build:e2e": "VITE_CLERK_PUBLISHABLE_KEY=pk_test_Y2xlcmsuZXhhbXBsZS5jb20k pnpm --recursive --workspace-concurrency=3 --filter '@moxt-ai/mobius-relay-cloudflare-standalone...' --if-present build",
        "test": "pnpm test:ci:client && pnpm test:ci:relay && pnpm test:ci:hosting",
        "test:agent-daemon": "pnpm test:agent-daemon:controlled && pnpm test:agent-daemon:real",
        "test:agent-daemon:controlled": "pnpm --filter @moxt-ai/mobius-fake-acp-agent build && vitest run --config vitest.agent-daemon.config.ts tests/agent-daemon/controlled-agent --maxWorkers=4",
        "test:agent-daemon:real": "vitest run --config vitest.agent-daemon.config.ts tests/agent-daemon/real --no-file-parallelism",
        "test:e2e": "pnpm build:e2e && vitest run e2e",
        "test:ci:client": "pnpm test:agent-daemon:controlled && vitest run packages/mobius-sdk/tests",
        "test:ci:relay": "pnpm build:e2e && vitest run packages/protocol/tests tests/runtime-server.integration.test.ts e2e",
        "test:ci:hosting": "pnpm test:integration:hosting",
        "test:changed": "vitest run --changed=origin/main",
        "test:integration:hosting": "pnpm test:integration:web && pnpm --recursive --workspace-concurrency=2 --filter @moxt-ai/mobius-relay-cloudflare-standalone --filter @moxt-ai/mobius-relay-cloudflare-platform run test:integration",
        "test:integration:platform": "pnpm --filter @moxt-ai/mobius-relay-cloudflare-platform test:integration",
        "test:integration:web": "pnpm --filter @moxt-ai/mobius-web test:integration",
        "test:integration:worker": "pnpm --filter @moxt-ai/mobius-relay-cloudflare-standalone test:integration",
        "test:watch": "vitest",
        "build:test": "VITE_CLERK_PUBLISHABLE_KEY=pk_test_Y2xlcmsuZXhhbXBsZS5jb20k pnpm build",
        "test:coverage": "pnpm build:test && node scripts/coverage.mjs",
        "test:coverage:suite": "node scripts/coverage.mjs --suite",
        "test:coverage:merge": "node scripts/coverage.mjs --merge-only",
        "knip": "VITE_CLERK_PUBLISHABLE_KEY=pk_test_Y2xlcmsuZXhhbXBsZS5jb20k knip",
        "check:static": "pnpm --filter mobius-workspace run --parallel '/^(lint|typecheck|knip)$/'",
        "ci:check": "pnpm check:static && pnpm test",
        "postinstall": "pnpm db:codegen && simple-git-hooks"
    },
    "simple-git-hooks": {
        "pre-commit": "pnpm biome check --staged --error-on-warnings --files-ignore-unknown=true --no-errors-on-unmatched && pnpm check:no-chinese && pnpm typecheck"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.14",
        "@types/node": "^24.13.5",
        "@vitest/coverage-istanbul": "4.1.11",
        "dependency-cruiser": "18.3.1",
        "drizzle-kit": "0.31.10",
        "happy-dom": "20.14.5",
        "istanbul-lib-coverage": "3.2.2",
        "istanbul-lib-report": "3.0.1",
        "istanbul-reports": "3.2.0",
        "knip": "^6.36.0",
        "simple-git-hooks": "^2.13.1",
        "typescript": "^7.0.2",
        "vitest": "^4.1.11"
    }
}
