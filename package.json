{
  "name": "mobius-workspace",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": ">=11.25.0 <12"
  },
  "scripts": {
    "dev": "pnpm dev:relay",
    "dev:cli": "pnpm --filter @moxt-ai/mobius dev",
    "dev:web": "pnpm --filter @moxt-ai/mobius-web dev",
    "dev:cloudflare": "pnpm --filter @moxt-ai/mobius-relay-cloudflare dev",
    "dev:relay": "pnpm dev:cloudflare",
    "dev:stack": "pnpm --parallel --filter @moxt-ai/mobius-relay-cloudflare --filter @moxt-ai/mobius-web dev",
    "deploy:temporary": "pnpm wrangler deploy --temporary",
    "mobius": "pnpm --filter @moxt-ai/mobius exec node src/cli.ts",
    "wrangler": "node scripts/wrangler.ts",
    "worktree:new": "bash scripts/worktree/new.sh",
    "worktree:setup": "bash scripts/worktree/setup.sh",
    "worktree:delete": "bash scripts/worktree/delete.sh",
    "worktree:reset": "bash scripts/worktree/reset.sh",
    "worktree:ports": "node scripts/worktree/port-allocator.mjs validate",
    "worktree:repair-ports": "node scripts/worktree/port-allocator.mjs repair",
    "build": "pnpm --filter @moxt-ai/mobius-protocol build && pnpm --filter @moxt-ai/mobius-relay-core build && pnpm --filter @moxt-ai/mobius-web-sdk build && pnpm --filter @moxt-ai/mobius-web build && pnpm --filter @moxt-ai/mobius-fake-acp-agent build && pnpm --filter @moxt-ai/mobius build && pnpm --filter @moxt-ai/mobius-relay-cloudflare build",
    "typecheck": "tsc --project tsconfig.json && pnpm --recursive --if-present typecheck",
    "check:no-chinese": "node scripts/check-no-chinese.ts",
    "lint": "biome ci --error-on-warnings && pnpm check:no-chinese",
    "lint:fix": "biome check --write --error-on-warnings && pnpm check:no-chinese",
    "format": "biome format --write",
    "test": "vitest run",
    "test:changed": "vitest run --changed=origin/main",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "check": "pnpm typecheck && pnpm build && pnpm lint && pnpm test:coverage && pnpm knip",
    "postinstall": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm typecheck && pnpm check:no-chinese && pnpm biome check --staged --files-ignore-unknown=true --no-errors-on-unmatched"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "knip": "^6.32.2",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
