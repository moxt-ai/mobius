{
  "name": "moebius",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "build": "tsc",
    "build:emit": "tsc --noCheck",
    "typecheck": "tsc --project tests/tsconfig.json",
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --write --error-on-warnings",
    "format": "biome format --write",
    "test": "vitest run",
    "test:changed": "vitest run --changed=origin/main",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "knip": "knip",
    "check": "pnpm typecheck && pnpm build && pnpm lint && pnpm test && pnpm knip",
    "postinstall": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "if git status --short | grep --quiet '^MM'; then printf '%s\\n' 'ERROR: Some staged files have unstaged changes' >&2; exit 1; fi; pnpm typecheck && pnpm biome check --write --staged --files-ignore-unknown=true --no-errors-on-unmatched && git update-index --again"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "knip": "^6.32.2",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "simple-git-hooks"
    ]
  }
}
