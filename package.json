{
  "name": "mobius",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": ">=11.25.0 <12"
  },
  "scripts": {
    "dev": "node --watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --project tests/tsconfig.json",
    "check:no-chinese": "node scripts/check-no-chinese.ts",
    "lint": "biome check --error-on-warnings && pnpm check:no-chinese",
    "lint:fix": "biome check --write --error-on-warnings && pnpm check:no-chinese",
    "format": "biome format --write",
    "test": "vitest run --passWithNoTests",
    "test:changed": "vitest run --changed=origin/main --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "knip": "knip",
    "check": "pnpm typecheck && pnpm build && pnpm lint && pnpm test:coverage && pnpm knip",
    "postinstall": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "if git status --short | grep --quiet '^MM'; then printf '%s\\n' 'ERROR: Some staged files have unstaged changes' >&2; exit 1; fi; pnpm typecheck && pnpm check:no-chinese && pnpm biome check --write --staged --files-ignore-unknown=true --no-errors-on-unmatched && git update-index --again"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "knip": "^6.32.2",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
