{
    "name": "mobius-workspace",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@11.25.0",
    "engines": {
        "node": ">=24.15.0 <25",
        "pnpm": ">=11.25.0 <12"
    },
    "scripts": {
        "db:shard": "bash scripts/migrate-shard.sh",
        "db:environment": "bash scripts/migrate-environment.sh",
        "dev": "pnpm dev:relay",
        "dev:cli": "pnpm --filter @moxt-ai/mobius dev",
        "dev:web": "pnpm --filter @moxt-ai/mobius-web dev",
        "dev:cloudflare": "pnpm --filter @moxt-ai/mobius-relay-cloudflare-standalone dev",
        "dev:cloudflare:platform": "pnpm --filter @moxt-ai/mobius-relay-cloudflare-platform dev",
        "dev:cloudflare:r2": "pnpm --filter @moxt-ai/mobius-relay-cloudflare-standalone dev:r2",
        "dev:relay": "pnpm dev:cloudflare",
        "dev:stack": "pnpm --parallel --filter @moxt-ai/mobius-relay-cloudflare-standalone --filter @moxt-ai/mobius-web dev",
        "deploy:temporary": "pnpm wrangler deploy --temporary",
        "deploy:cloudflare:r2": "pnpm --filter @moxt-ai/mobius-relay-cloudflare-standalone deploy:r2",
        "deploy:cloudflare:platform": "pnpm --filter @moxt-ai/mobius-relay-cloudflare-platform run deploy",
        "mobius": "pnpm --filter @moxt-ai/mobius exec node src/cli.ts",
        "wrangler": "node scripts/wrangler.ts",
        "worktree:new": "bash scripts/worktree/new.sh",
        "worktree:setup": "bash scripts/worktree/setup.sh",
        "worktree:delete": "bash scripts/worktree/delete.sh",
        "worktree:reset": "bash scripts/worktree/reset.sh",
        "worktree:ports": "node scripts/worktree/port-allocator.mjs validate",
        "worktree:repair-ports": "node scripts/worktree/port-allocator.mjs repair",
        "build": "pnpm --recursive --workspace-concurrency=3 --filter '!@moxt-ai/mobius-web' --filter '!@moxt-ai/mobius-platform-app' --if-present build",
        "typecheck": "tsc --project tsconfig.json && pnpm --recursive --if-present typecheck",
        "check:no-chinese": "node scripts/check-no-chinese.ts",
        "lint": "biome ci --error-on-warnings && pnpm check:no-chinese && pnpm check:architecture",
        "check:architecture": "depcruise --config dependency-cruiser.config.cjs packages/*/src",
        "lint:fix": "biome check --write --error-on-warnings && pnpm check:no-chinese",
        "format": "biome format --write",
        "test": "vitest run && pnpm test:integration",
        "test:ci": "vitest run",
        "test:changed": "vitest run --changed=origin/main",
        "test:integration:cli": "pnpm --filter @moxt-ai/mobius-fake-acp-agent build && vitest run packages/cli/tests",
        "test:integration": "pnpm test:integration:web && pnpm --recursive --workspace-concurrency=2 --filter @moxt-ai/mobius-relay-cloudflare-standalone --filter @moxt-ai/mobius-relay-cloudflare-platform run test:integration",
        "test:integration:platform": "pnpm --filter @moxt-ai/mobius-relay-cloudflare-platform test:integration",
        "test:integration:web": "pnpm --filter @moxt-ai/mobius-web test:integration",
        "test:integration:worker": "pnpm --filter @moxt-ai/mobius-relay-cloudflare-standalone test:integration",
        "test:watch": "vitest",
        "test:coverage": "pnpm build && node scripts/coverage.mjs",
        "knip": "knip",
        "check": "pnpm --filter mobius-workspace run --parallel '/^(lint|typecheck|knip)$/' && pnpm test:coverage",
        "postinstall": "simple-git-hooks"
    },
    "simple-git-hooks": {
        "pre-commit": "pnpm biome check --staged --error-on-warnings --files-ignore-unknown=true --no-errors-on-unmatched && pnpm check:no-chinese && pnpm typecheck"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.13",
        "@types/node": "^24.13.4",
        "@vitest/coverage-istanbul": "4.1.11",
        "dependency-cruiser": "18.2.0",
        "happy-dom": "20.14.3",
        "istanbul-lib-coverage": "3.2.2",
        "istanbul-lib-report": "3.0.1",
        "istanbul-reports": "3.2.0",
        "knip": "^6.35.1",
        "simple-git-hooks": "^2.13.1",
        "typescript": "^7.0.2",
        "undici": "7.29.0",
        "vitest": "^4.1.11"
    }
}
