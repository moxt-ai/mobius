{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "workspaces": {
        "packages/cli": {
            "entry": ["src/index.ts", "src/runtime.ts"]
        },
        "packages/web-core": {
            "project": ["src/**/*.{ts,tsx}"]
        },
        "packages/web": {
            "ignoreDependencies": [
                "@radix-ui/react-select",
                "class-variance-authority",
                "clsx",
                "lucide-react",
                "react-router",
                "streamdown",
                "tailwind-merge",
                "zustand"
            ]
        },
        "packages/relay-cloudflare-standalone": {
            "ignoreDependencies": ["cloudflare"]
        },
        "packages/relay-cloudflare-platform": {
            "entry": ["scripts/regional-workers.ts", "scripts/sharding-migrations.ts"],
            "ignoreDependencies": ["cloudflare"]
        },
        "packages/mobius-sdk": {
            "entry": ["examples/*.ts"]
        }
    }
}
