{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "workspaces": {
        "packages/web-core": {
            "project": ["src/**/*.{ts,tsx}"]
        },
        "packages/web": {
            "ignoreDependencies": [
                "@moxt-ai/mobius-sdk",
                "@radix-ui/react-select",
                "class-variance-authority",
                "clsx",
                "lucide-react",
                "react-router",
                "streamdown",
                "tailwind-merge",
                "zustand"
            ]
        },
        "packages/relay-cloudflare": {
            "ignoreDependencies": ["cloudflare"]
        },
        "packages/web-sdk": {
            "entry": ["examples/*.ts"]
        }
    }
}
