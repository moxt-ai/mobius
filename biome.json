{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "defaultBranch": "main",
        "useIgnoreFile": true
    },
    "files": {
        "includes": ["**", "!!**/dist", "!!**/coverage", "!!**/worker-configuration.d.ts"]
    },
    "linter": {
        "enabled": true,
        "domains": {
            "project": "recommended",
            "types": "recommended",
            "test": "recommended"
        },
        "rules": {
            "preset": "recommended",
            "complexity": {
                "useLiteralKeys": "off",
                "noUselessConstructor": "error"
            },
            "style": {
                "useBlockStatements": "error"
            },
            "nursery": {
                "noFloatingPromises": "error",
                "noMisusedPromises": "error",
                "useExhaustiveSwitchCases": "error"
            }
        }
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    }
}
