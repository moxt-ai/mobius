{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "mobius-standalone-test",
    "main": "src/worker.ts",
    "compatibility_date": "2026-09-03",
    "durable_objects": {
        "bindings": [{ "name": "RUNTIME_RELAY", "class_name": "RuntimeRelay" }]
    },
    "migrations": [{ "tag": "standalone-initial", "new_sqlite_classes": ["RuntimeRelay"] }],
    "d1_databases": [{ "binding": "DIRECTORY_DATABASE", "migrations_dir": "migrations/d1" }],
    "services": [{ "binding": "RECORDING", "service": "mobius-recording-test" }],
    "vars": { "RECORDING_PROVIDER_ID": "recording-test" },
    "observability": { "enabled": true }
}
