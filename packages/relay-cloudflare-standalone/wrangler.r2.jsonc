{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "mobius-relay",
    "main": "src/worker.ts",
    "compatibility_date": "2026-09-03",
    "durable_objects": {
        "bindings": [
            {
                "name": "RUNTIME_RELAY",
                "class_name": "RuntimeRelay"
            },
            {
                "name": "SESSION_RELAY",
                "class_name": "SessionRelay"
            },
            {
                "name": "BOT_CONNECTIONS",
                "class_name": "BotConnectionActor"
            }
        ]
    },
    "migrations": [
        {
            "tag": "initial",
            "new_sqlite_classes": ["RuntimeRelay", "SessionRelay"]
        },
        {
            "tag": "lite-session-storage",
            "new_sqlite_classes": ["LiteSessionRelay"]
        },
        {
            "tag": "bot-connections",
            "new_sqlite_classes": ["BotConnectionActor"]
        }
    ],
    "d1_databases": [
        {
            "binding": "DIRECTORY_DATABASE",
            "migrations_dir": "../relay-cloudflare/migrations/d1"
        }
    ],
    "r2_buckets": [
        {
            "binding": "SESSION_ARCHIVES",
            "bucket_name": "mobius-session-archives"
        }
    ],
    "vars": {
        "MOBIUS_TENANT_ID": "standalone",
        "PUBLIC_PROJECT_BOOTSTRAP_CLIENT_LIMIT": "10",
        "PUBLIC_PROJECT_BOOTSTRAP_ENABLED": "true",
        "PUBLIC_PROJECT_BOOTSTRAP_TENANT_LIMIT": "100",
        "PUBLIC_PROJECT_BOOTSTRAP_WINDOW_SECONDS": "3600",
        "SESSION_ACTIVE_SESSIONS_PER_PROJECT": "1000"
    },
    "assets": {
        "directory": "../web/dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/mobius/api/*"]
    },
    "observability": {
        "enabled": true
    }
}
