{
    "name": "@moxt-ai/mobius-relay-cloudflare-standalone",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "main": "./src/worker.ts",
    "exports": {
        ".": "./src/worker.ts"
    },
    "scripts": {
        "prebuild": "pnpm --dir ../.. db:codegen",
        "build": "pnpm --filter @moxt-ai/mobius-web build && wrangler deploy --dry-run --config wrangler.jsonc --outdir dist/lite && wrangler deploy --dry-run --config wrangler.r2.jsonc --outdir dist/r2",
        "deploy": "pnpm --dir ../.. wrangler deploy",
        "deploy:r2": "pnpm --dir ../.. wrangler deploy --config wrangler.r2.jsonc",
        "dev": "pnpm --filter @moxt-ai/mobius-web build && pnpm --dir ../.. wrangler dev",
        "dev:r2": "pnpm --filter @moxt-ai/mobius-web build && pnpm --dir ../.. wrangler dev --config wrangler.r2.jsonc",
        "pretest:integration": "pnpm --dir ../.. db:codegen",
        "pretypecheck": "pnpm --dir ../.. db:codegen",
        "test:integration": "vitest run --config vitest.config.ts --max-workers=1 --no-isolate",
        "typecheck": "tsc --project tsconfig.json && tsc --project tsconfig.vitest.json && tsc --project test/tsconfig.json"
    },
    "dependencies": {
        "@moxt-ai/mobius-protocol": "workspace:*",
        "@moxt-ai/mobius-relay-core": "workspace:*",
        "drizzle-orm": "^0.45.2",
        "hono": "^4.13.7"
    },
    "devDependencies": {
        "@cloudflare/vitest-plugin": "^1.1.7",
        "@cloudflare/workers-types": "^5.20260911.1",
        "@moxt-ai/mobius-sdk": "workspace:*",
        "wrangler": "^4.131.0"
    }
}
