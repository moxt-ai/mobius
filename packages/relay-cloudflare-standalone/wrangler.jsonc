{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "mobius-standalone",
    "main": "src/worker.ts",
    "compatibility_date": "2026-09-03",
    "durable_objects": {
        "bindings": [
            { "name": "RUNTIME_RELAY", "class_name": "RuntimeRelay" },
            { "name": "SESSION_RELAY", "class_name": "StandaloneSessionRelay" }
        ]
    },
    "migrations": [{ "tag": "standalone-initial", "new_sqlite_classes": ["RuntimeRelay", "StandaloneSessionRelay"] }],
    "d1_databases": [{ "binding": "DIRECTORY_DATABASE", "migrations_dir": "../relay-core/migrations/d1" }],
    "vars": {
        "SESSION_ACTIVE_SESSIONS_PER_PROJECT": "1000",
        "SESSION_ARCHIVE_BYTES_PER_SESSION": "268435456"
    }
}
