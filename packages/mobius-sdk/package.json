{
    "name": "@moxt-ai/mobius-sdk",
    "version": "0.0.51",
    "description": "Unified Mobius TypeScript SDK for browsers and Node.js.",
    "type": "module",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./channel": "./src/channel.ts",
        "./platform": "./src/platform.ts",
        "./server": "./src/server.ts",
        "./standalone": "./src/standalone.ts"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "engines": {
        "node": ">=20.19.0"
    },
    "publishConfig": {
        "access": "public",
        "types": "./dist/index.d.ts",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js"
            },
            "./channel": {
                "types": "./dist/channel.d.ts",
                "import": "./dist/channel.js"
            },
            "./platform": {
                "types": "./dist/platform.d.ts",
                "import": "./dist/platform.js"
            },
            "./server": {
                "types": "./dist/server.d.ts",
                "import": "./dist/server.js"
            },
            "./standalone": {
                "types": "./dist/standalone.d.ts",
                "import": "./dist/standalone.js"
            }
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/moxt-ai/mobius.git",
        "directory": "packages/mobius-sdk"
    },
    "scripts": {
        "build": "tsc --project tsconfig.build.json",
        "prepack": "pnpm build",
        "typecheck": "tsc --project tsconfig.json"
    },
    "dependencies": {
        "@moxt-ai/mobius-protocol": "workspace:*",
        "base64-js": "^1.5.1",
        "partysocket": "1.3.0"
    },
    "devDependencies": {
        "@types/node": "^24.13.5",
        "happy-dom": "20.14.5"
    },
    "sideEffects": false,
    "license": "ISC"
}
