{
    "name": "@moxt-ai/mobius-sdk",
    "version": "0.0.168",
    "description": "Unified Mobius TypeScript SDK for browsers and Node.js.",
    "type": "module",
    "types": "./src/index.ts",
    "exports": {
        ".": "./src/index.ts",
        "./channel": "./src/channel.ts",
        "./platform": "./src/platform.ts",
        "./server": "./src/server.ts",
        "./protocol": "./src/protocol/index.ts"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "engines": {
        "node": ">=20.19.0"
    },
    "publishConfig": {
        "access": "public",
        "types": "./dist/index.d.ts",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "default": "./dist/index.js"
            },
            "./channel": {
                "types": "./dist/channel.d.ts",
                "import": "./dist/channel.js",
                "default": "./dist/channel.js"
            },
            "./platform": {
                "types": "./dist/platform.d.ts",
                "import": "./dist/platform.js",
                "default": "./dist/platform.js"
            },
            "./server": {
                "types": "./dist/server.d.ts",
                "import": "./dist/server.js",
                "default": "./dist/server.js"
            },
            "./protocol": {
                "types": "./dist/protocol/index.d.ts",
                "import": "./dist/protocol/index.js",
                "default": "./dist/protocol/index.js"
            }
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/moxt-ai/mobius.git",
        "directory": "packages/mobius-sdk"
    },
    "scripts": {
        "build": "tsc --project tsconfig.build.json",
        "prepack": "pnpm build",
        "typecheck": "tsc --project tsconfig.json"
    },
    "dependencies": {
        "partysocket": "1.3.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/node": "^24.13.5",
        "happy-dom": "21.0.4"
    },
    "sideEffects": false,
    "license": "Apache-2.0",
    "author": "Moxt",
    "homepage": "https://github.com/moxt-ai/mobius#readme",
    "bugs": {
        "url": "https://github.com/moxt-ai/mobius/issues"
    }
}
