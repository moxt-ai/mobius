{
  "name": "@moxt-ai/mobius-relay-cloudflare",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/worker.ts",
  "scripts": {
    "build": "pnpm --filter @moxt-ai/mobius-web build && wrangler deploy --dry-run --outdir dist",
    "deploy": "pnpm --dir ../.. wrangler deploy",
    "dev": "pnpm --filter @moxt-ai/mobius-web build && pnpm --dir ../.. wrangler dev",
    "typecheck": "tsc --project tsconfig.json"
  },
  "dependencies": {
    "@moxt-ai/mobius-protocol": "workspace:*",
    "@moxt-ai/mobius-relay-core": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260814.1",
    "wrangler": "^4.128.0"
  }
}
