{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mobius-relay",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-03",
  "durable_objects": {
    "bindings": [
      {
        "name": "RUNTIME_RELAY",
        "class_name": "RuntimeRelay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RuntimeRelay"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DIRECTORY_DATABASE",
      "migrations_dir": "migrations/d1"
    }
  ],
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/health", "/v1/*"]
  },
  "observability": {
    "enabled": true
  }
}
