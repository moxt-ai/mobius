{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "declaration": true,
        "declarationMap": true,
        "noEmit": false,
        "outDir": "dist/examples",
        "paths": {
            "@moxt-ai/mobius-sdk": ["./dist/index.d.ts"]
        },
        "rootDir": "examples",
        "sourceMap": true,
        "target": "ES2022"
    },
    "include": ["examples/**/*.ts"],
    "exclude": ["src", "tests"]
}
