{
    "name": "@moxt-ai/mobius",
    "version": "0.0.285",
    "description": "Mobius CLI for pairing and running local AI agent services.",
    "type": "module",
    "bin": {
        "mobius": "dist/cli.js"
    },
    "exports": {
        "./runtime": "./src/runtime.ts",
        "./process": "./src/util/process/executable.ts",
        "./filesystem": "./src/util/filesystem/private-path.ts"
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=22.13.0"
    },
    "publishConfig": {
        "access": "public",
        "exports": {
            "./runtime": {
                "types": "./dist/runtime.d.ts",
                "import": "./dist/runtime.js",
                "default": "./dist/runtime.js"
            },
            "./process": {
                "types": "./dist/util/process/executable.d.ts",
                "import": "./dist/util/process/executable.js",
                "default": "./dist/util/process/executable.js"
            },
            "./filesystem": {
                "types": "./dist/util/filesystem/private-path.d.ts",
                "import": "./dist/util/filesystem/private-path.js",
                "default": "./dist/util/filesystem/private-path.js"
            }
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/moxt-ai/mobius.git",
        "directory": "packages/cli"
    },
    "scripts": {
        "prebuild": "tsc --project src/acp/harness/claude/upstream/tsconfig.json && tsc --project src/acp/harness/pi/upstream/tsconfig.json",
        "build": "tsc --project tsconfig.build.json && esbuild cli=src/cli/entrypoint.ts runtime=src/runtime.ts src/util/process/executable.ts src/util/filesystem/private-path.ts --bundle --platform=node --format=esm --sourcemap --outbase=src --outdir=dist --external:@agentclientprotocol/sdk --external:undici",
        "dev": "node --watch src/cli/entrypoint.ts",
        "pretypecheck": "tsc --project src/acp/harness/claude/upstream/tsconfig.json && tsc --project src/acp/harness/pi/upstream/tsconfig.json",
        "prepack": "pnpm build",
        "start": "node dist/cli.js",
        "typecheck": "tsc --project tsconfig.json && tsc --project tests/tsconfig.json",
        "pretest:controlled": "tsc --project src/acp/harness/claude/upstream/tsconfig.json && tsc --project src/acp/harness/pi/upstream/tsconfig.json",
        "test:controlled": "vitest run tests/sessions tests/runtime --maxWorkers=4",
        "pretest:manual": "pnpm pretest:controlled",
        "test:manual": "vitest run tests/manual",
        "pretest:agents": "tsc --project src/acp/harness/claude/upstream/tsconfig.json && tsc --project src/acp/harness/pi/upstream/tsconfig.json",
        "test:agents": "vitest run tests/agents --maxWorkers=2",
        "pretest:npm-compatibility": "tsc --project src/acp/harness/claude/upstream/tsconfig.json && tsc --project src/acp/harness/pi/upstream/tsconfig.json",
        "test:npm-compatibility": "vitest run tests/runtime/daemon-upgrade.integration.test.ts",
        "pretest:pressure": "tsc --project src/acp/harness/claude/upstream/tsconfig.json && tsc --project src/acp/harness/pi/upstream/tsconfig.json",
        "test:pressure": "node tests/pressure/concurrent-sessions.mjs"
    },
    "dependencies": {
        "@agentclientprotocol/sdk": "^1.4.0",
        "@anthropic-ai/claude-agent-sdk": "0.3.257",
        "commander": "15.0.0",
        "semver": "^7.8.5",
        "undici": "8.10.2",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@anthropic-ai/sdk": "0.122.0",
        "@moxt-ai/mobius-sdk": "workspace:*",
        "@moxt-ai/mobius-test": "workspace:*",
        "@types/node": "^24.13.5",
        "@types/semver": "^7.8.0",
        "@types/ws": "^8.18.1",
        "drizzle-kit": "1.0.0-rc.4",
        "drizzle-orm": "1.0.0-rc.4",
        "esbuild": "0.28.2",
        "valibot": "1.5.0",
        "ws": "^8.21.3"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/moxt-ai/mobius/issues"
    },
    "homepage": "https://github.com/moxt-ai/mobius#readme"
}
