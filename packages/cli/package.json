{
    "name": "@moxt-ai/mobius",
    "version": "0.0.155",
    "description": "Mobius CLI for pairing and running local AI agent services.",
    "type": "module",
    "bin": {
        "mobius": "dist/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./runtime": {
            "types": "./dist/runtime.d.ts",
            "import": "./dist/runtime.js"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=22.13.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/moxt-ai/mobius.git",
        "directory": "packages/cli"
    },
    "scripts": {
        "build": "tsc --project tsconfig.build.json && esbuild src/cli.ts src/index.ts src/runtime.ts --bundle --platform=node --format=esm --sourcemap --outdir=dist --external:@agentclientprotocol/* --external:better-sqlite3 --external:undici",
        "dev": "node --watch src/cli.ts",
        "prepack": "pnpm build",
        "start": "node dist/cli.js",
        "typecheck": "tsc --project tsconfig.json && tsc --project tests/tsconfig.json",
        "test:controlled": "vitest run tests/sessions tests/runtime --maxWorkers=4",
        "test:agents": "vitest run tests/agents --maxWorkers=2"
    },
    "dependencies": {
        "@agentclientprotocol/sdk": "^1.4.0",
        "better-sqlite3": "12.4.1",
        "commander": "15.0.0",
        "undici": "8.10.2",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@moxt-ai/mobius-protocol": "workspace:*",
        "@types/better-sqlite3": "7.6.13",
        "@types/node": "^24.13.5",
        "drizzle-orm": "^0.45.2",
        "esbuild": "0.28.2",
        "@moxt-ai/mobius-sdk": "workspace:*",
        "@moxt-ai/mobius-test": "workspace:*",
        "valibot": "1.5.0",
        "ws": "^8.21.3",
        "@types/ws": "^8.18.1"
    },
    "main": "dist/index.js",
    "keywords": [],
    "author": "",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/moxt-ai/mobius/issues"
    },
    "homepage": "https://github.com/moxt-ai/mobius#readme"
}
