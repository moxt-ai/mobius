{
    "name": "@moxt-ai/mobius-recording-cloudflare",
    "version": "0.0.1",
    "license": "Apache-2.0",
    "private": true,
    "type": "module",
    "exports": {
        ".": "./src/worker.ts"
    },
    "scripts": {
        "prebuild": "pnpm --dir ../.. db:codegen",
        "build": "wrangler deploy --dry-run --config wrangler.jsonc --outdir dist",
        "pretest:integration": "pnpm --dir ../.. db:codegen",
        "pretypecheck": "pnpm --dir ../.. db:codegen",
        "test:integration": "vitest run --config vitest.config.ts --max-workers=1 --no-isolate",
        "typecheck": "tsc --project tsconfig.json && tsc --project test/tsconfig.json"
    },
    "dependencies": {
        "@moxt-ai/mobius-sdk": "workspace:*",
        "drizzle-orm": "^0.45.2",
        "hono": "^4.13.14",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@cloudflare/vitest-plugin": "^1.4.9",
        "@cloudflare/workers-types": "^5.20261028.1",
        "@moxt-ai/mobius-sdk-previous": "npm:@moxt-ai/mobius-sdk@0.0.136",
        "@types/node": "^24.13.5",
        "vitest": "^4.1.12",
        "wrangler": "^4.154.0"
    }
}
