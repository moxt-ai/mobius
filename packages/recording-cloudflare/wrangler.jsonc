{
    "$schema": "../../node_modules/wrangler/config-schema.json",
    "name": "mobius-recording-local",
    "main": "src/worker.ts",
    "compatibility_date": "2026-09-03",
    "durable_objects": {
        "bindings": [
            { "name": "SESSION_RECORDING", "class_name": "SessionRecordingDurableObject" },
            { "name": "RECORDING_DIRECTORY", "class_name": "RecordingDirectoryDurableObject" }
        ]
    },
    "migrations": [
        {
            "tag": "recording-initial",
            "new_sqlite_classes": ["SessionRecordingDurableObject", "RecordingDirectoryDurableObject"]
        }
    ],
    "observability": { "enabled": true },
    "env": {
        "production": {
            "name": "mobius-recording-production",
            "workers_dev": false,
            "preview_urls": false,
            "durable_objects": {
                "bindings": [
                    { "name": "SESSION_RECORDING", "class_name": "SessionRecordingDurableObject" },
                    { "name": "RECORDING_DIRECTORY", "class_name": "RecordingDirectoryDurableObject" }
                ]
            }
        }
    }
}
