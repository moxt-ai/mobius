{
    "name": "@moxt-ai/mobius-protocol",
    "version": "0.0.84",
    "description": "Versioned public Mobius protocol resources and codecs.",
    "type": "module",
    "types": "./src/index.ts",
    "exports": "./src/index.ts",
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=20.19.0"
    },
    "publishConfig": {
        "access": "public",
        "types": "./dist/index.d.ts",
        "exports": {
            ".": {
                "types": "./dist/index.d.ts",
                "import": "./dist/index.js",
                "default": "./dist/index.js"
            }
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/moxt-ai/mobius.git",
        "directory": "packages/protocol"
    },
    "scripts": {
        "build": "tsc --project tsconfig.build.json",
        "prepack": "pnpm build",
        "typecheck": "tsc --project tsconfig.json"
    },
    "dependencies": {
        "zod": "^4.6.5"
    },
    "sideEffects": false,
    "license": "ISC"
}
